{
  "name": "@plywise/chessboard",
  "version": "0.4.2",
  "description": "A small, framework-agnostic chessboard renderer.",
  "keywords": [
    "chess",
    "chessboard",
    "typescript"
  ],
  "homepage": "https://github.com/plywise-io/chessboard#readme",
  "bugs": {
    "url": "https://github.com/plywise-io/chessboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plywise-io/chessboard.git",
    "directory": "packages/chessboard"
  },
  "type": "module",
  "sideEffects": [
    "./dist/style.css"
  ],
  "files": [
    "dist/index.d.ts",
    "dist/index.js",
    "dist/internal/values.d.ts",
    "dist/internal/values.js",
    "dist/internal/pieceSets.gen.d.ts",
    "dist/internal/pieceSets.gen.js",
    "dist/style.css",
    "dist/style.d.ts",
    "assets/SETS.md",
    "assets/cburnett/LICENSE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "types": "./dist/style.d.ts",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "prepack": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
