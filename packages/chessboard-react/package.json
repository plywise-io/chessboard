{
  "name": "@plywise/chessboard-react",
  "version": "0.2.2",
  "description": "React adapter for @plywise/chessboard.",
  "keywords": [
    "chess",
    "chessboard",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/plywise-io/chessboard#readme",
  "bugs": {
    "url": "https://github.com/plywise-io/chessboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plywise-io/chessboard.git",
    "directory": "packages/chessboard-react"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build -w @plywise/chessboard && npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@plywise/chessboard": "^0.3.3"
  },
  "peerDependencies": {
    "react": ">=18 <21"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
